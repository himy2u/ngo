# ===================================================================
# AZURE DATABRICKS CONFIGURATION
# ===================================================================
#
# Copy this file to .env.databricks and fill in your values
# NEVER commit .env.databricks to git - it contains secrets!
#
# ===================================================================

# -------------------------------------------------------------------
# DATABRICKS WORKSPACE CONNECTION
# -------------------------------------------------------------------

# Your Databricks workspace URL
# Example: https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_HOST=

# Personal Access Token (create in User Settings > Access Tokens)
# Example: dapi_YOUR_TOKEN_HERE_abc123
DATABRICKS_TOKEN=

# Workspace ID (optional - used for organization)
DATABRICKS_WORKSPACE_ID=

# -------------------------------------------------------------------
# DATABRICKS SQL WAREHOUSE (for queries)
# -------------------------------------------------------------------

# SQL Warehouse HTTP Path
# Example: /sql/1.0/warehouses/abc123def456
DATABRICKS_SQL_WAREHOUSE_PATH=

# SQL Warehouse ID
DATABRICKS_SQL_WAREHOUSE_ID=

# -------------------------------------------------------------------
# DATABRICKS CLUSTER (for Spark jobs)
# -------------------------------------------------------------------

# Cluster ID for running Spark jobs
# Example: 1234-567890-abcdef12
DATABRICKS_CLUSTER_ID=

# -------------------------------------------------------------------
# UNITY CATALOG CONFIGURATION
# -------------------------------------------------------------------

# Catalog name (Unity Catalog namespace)
# Example: ngo_platform_dev
DATABRICKS_CATALOG=ngo_platform_dev

# Schema names for medallion architecture
DATABRICKS_SCHEMA_BRONZE=bronze
DATABRICKS_SCHEMA_SILVER=silver
DATABRICKS_SCHEMA_GOLD=gold

# -------------------------------------------------------------------
# DELTA LAKE STORAGE
# -------------------------------------------------------------------

# Azure Storage Account for Delta Lake tables
# Example: abfss://data@mystorageaccount.dfs.core.windows.net
DATABRICKS_STORAGE_PATH=

# Azure Storage Account Name
AZURE_STORAGE_ACCOUNT_NAME=

# Azure Storage Account Key (SAS token or access key)
AZURE_STORAGE_ACCOUNT_KEY=

# -------------------------------------------------------------------
# DATA MIGRATION SETTINGS
# -------------------------------------------------------------------

# PostgreSQL connection for data migration to Databricks
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=petitions

# -------------------------------------------------------------------
# ENVIRONMENT
# -------------------------------------------------------------------

# Environment: dev, staging, prod
ENVIRONMENT=dev

# Enable debug logging
DEBUG_MODE=true

# -------------------------------------------------------------------
# GETTING STARTED
# -------------------------------------------------------------------
#
# 1. Sign up for Azure Databricks Community Edition (FREE):
#    https://community.cloud.databricks.com/
#
# 2. Create a workspace and note your workspace URL
#
# 3. Generate a Personal Access Token:
#    - Click your user profile > User Settings
#    - Go to Access Tokens tab
#    - Click "Generate New Token"
#    - Copy the token (you won't see it again!)
#
# 4. Create a SQL Warehouse:
#    - Go to SQL Warehouses in sidebar
#    - Click "Create SQL Warehouse"
#    - Select "Serverless" (fastest startup)
#    - Note the HTTP Path
#
# 5. Fill in the values above and save as .env.databricks
#
# 6. Test connection:
#    python data/databricks/test_connection.py
#
# ===================================================================
