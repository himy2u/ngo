{
  "dashboard": {
    "title": "Pipeline Health",
    "uid": "pipeline-health",
    "timezone": "utc",
    "panels": [
      {
        "title": "Pipeline Runs",
        "type": "stat",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "sum(pipeline_runs_total)",
            "legendFormat": "Total Runs"
          }
        ]
      },
      {
        "title": "Success Rate",
        "type": "gauge",
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "sum(pipeline_runs_total{status=\"success\"}) / sum(pipeline_runs_total) * 100",
            "legendFormat": "Success %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "max": 100,
            "min": 0,
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 90},
                {"color": "green", "value": 99}
              ]
            }
          }
        }
      },
      {
        "title": "Records Ingested",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "rate(pipeline_records_ingested_total[5m])",
            "legendFormat": "{{pipeline}} - {{status}}"
          }
        ]
      },
      {
        "title": "Quarantine Depth",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 10, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "pipeline_quarantine_depth",
            "legendFormat": "{{pipeline}}"
          }
        ]
      },
      {
        "title": "Pipeline Duration (p95)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(pipeline_duration_seconds_bucket[5m]))",
            "legendFormat": "{{pipeline}}"
          }
        ]
      }
    ]
  }
}
